{
  "name": "alcovia-study-app",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace backend run dev\" \"npm --workspace frontend run web\"",
    "dev:client": "npm --workspace frontend run web",
    "dev:server": "npm --workspace backend run dev",
    "build": "npm --workspace backend run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}

