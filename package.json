{
  "name": "alcovia-study-app",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace server run dev\" \"npm --workspace client run web\"",
    "dev:client": "npm --workspace client run web",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace server run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}

